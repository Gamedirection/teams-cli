{
  "name": "teams-token",
  "version": "2.0.0",
  "description": "Get your MS Teams token easily (terminal-only, no desktop required)",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "yarn run build && node ./dist/main.js",
    "logout": "node ./dist/main.js logout",
    "get-url": "node ./dist/main.js get-url"
  },
